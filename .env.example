# Akamai cheap tier — HOST handed out at kickoff. Port 8080 (verified from quickstart).
# Quickstart hardcodes host `agentgateway` (docker-compose service name) which is only
# resolvable inside their network — at kickoff we get an external host or IP.
AKAMAI_INFERENCE_URL=http://REPLACE_AT_KICKOFF:8080/v1
# Provided at kickoff. Fill into your local .env (which is gitignored). Never commit.
AKAMAI_TOKEN=
# Cluster serves Qwen3-8B-FP8 (verified) — NOT Llama-3-8B-Instruct as earlier draft assumed.
CHEAP_MODEL=Qwen/Qwen3-8B-FP8

# Premium tier — Claude Sonnet 4.6 via Anthropic API.
# Pricing verified at platform.claude.com on 2026-06-10: $3/MTok input, $15/MTok output.
ANTHROPIC_API_KEY=
PREMIUM_MODEL=claude-sonnet-4-6

# Evidence search (two keys mandatory — failover insurance for the live demo)
TAVILY_API_KEY=
TAVILY_API_KEY_BACKUP=

# Magnific (Freepik) image generation — for the honest-ad stage. Required for
# the dual-tier eligibility floor. Prefer the OAuth MCP flow for live generation;
# the API key is only a fallback path.
FREEPIK_API_KEY=
# Optional command for OAuth/MCP-backed generation. The command receives JSON on
# stdin and prints either a URL or {"url":"..."} on stdout.
# Local Codex/Magnific OAuth bridge:
# HONEST_AD_IMAGE_COMMAND=/absolute/path/to/backend/scripts/magnific_mcp_bridge.py
HONEST_AD_IMAGE_COMMAND=
HONEST_AD_TOP_N=25

# Run knobs
N_VENDORS=10
SEMAPHORE=8
JUDGE_CONFIDENCE_THRESHOLD=0.7
SCRAPE_TIMEOUT_S=10
LLM_TIMEOUT_S=45
